# Required - generate with: python generate_secret_key.py
SECRET_KEY=

# Optional - admin user is created on first run only when BOTH are set
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional API keys - related lookups report a clear message when unset
SHODAN_API_KEY=
IPINFO_ACCESS_TOKEN=
VIRUSTOTAL_API_KEY=
HIBP_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=

# Optional - local development only, never enable in production
FLASK_DEBUG=false
